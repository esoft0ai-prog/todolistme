{
  "name": "camplo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch server/dev.ts",
    "start": "tsx server/dev.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate-cli.ts",
    "db:seed": "tsx server/db/seed-cli.ts",
    "vercel-build": "tsc -p tsconfig.build.json && mkdir -p dist/server/db && cp -r server/db/migrations dist/server/db/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@electric-sql/pglite": "^0.5.8",
    "@langchain/core": "^1.2.12",
    "@langchain/langgraph": "^1.4.18",
    "@orpc/openapi": "^1.15.4",
    "@orpc/server": "^1.15.4",
    "@vectorize-io/hindsight-client": "^0.10.1",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.9",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "pdfkit": "^0.20.2",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
